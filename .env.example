# Show the Ask tab in the app (vite reads VITE_ variables)
VITE_TUTOR=on
# Read by the tutor server only. Never put a real key in a committed file.
ANTHROPIC_API_KEY=
# To use Gemini instead of Claude: TUTOR_PROVIDER=gemini and a Gemini key.
# GEMINI_MODEL is optional (default gemini-flash-latest).
TUTOR_PROVIDER=claude
GEMINI_API_KEY=
GEMINI_MODEL=
